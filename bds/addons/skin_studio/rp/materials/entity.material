{
  "materials": {
    "version": "1.0.0",
    "skin_studio_mask:entity": {
      "+states": [
        "EnableStencilTest",
        "StencilWrite",
        "DisableColorWrite",
        "DisableDepthWrite"
      ],
      "stencilRef": 1,
      "stencilReadMask": 1,
      "stencilWriteMask": 1,
      "frontFace": {
        "stencilFunc": "Always",
        "stencilFailOp": "Keep",
        "stencilDepthFailOp": "Keep",
        "stencilPassOp": "Replace"
      },
      "backFace": {
        "stencilFunc": "Always",
        "stencilFailOp": "Keep",
        "stencilDepthFailOp": "Keep",
        "stencilPassOp": "Replace"
      }
    },
